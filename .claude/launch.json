{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "venv/bin/python",
      "runtimeArgs": [
        "api/app.py"
      ],
      "port": 5001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "realmchess-frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "hosted",
      "runtimeExecutable": "venv/bin/python",
      "runtimeArgs": [
        "serve.py"
      ],
      "port": 8000
    }
  ]
}